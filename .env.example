# Postgres (docker-compose maps 5433 on the host to avoid clashing with a local server)
DATABASE_URL=postgres://kh:kh@localhost:5433/kh_workers
DATABASE_MAX_CONNECTIONS=10

# Worker runtime
WORKER_CONCURRENCY=4
POLL_INTERVAL_MS=5000
SHUTDOWN_GRACE_SECS=30
REAPER_INTERVAL_SECS=30
STALE_AFTER_SECS=120

# Retry backoff
BACKOFF_BASE_MS=5000
BACKOFF_MAX_MS=300000
BACKOFF_JITTER=0.2

# Optional worker identity (defaults to worker-<pid>-<random>)
# WORKER_ID=worker-1

# Logging
RUST_LOG=info,kh_db=debug,kh_queue=debug
